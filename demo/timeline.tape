# 타임라인 — AI가 언제부터 망쳤는지 한눈에.
Output timeline.gif
Set FontSize 16
Set FontFamily "D2Coding"
Set Width 1180
Set Height 400
Set Theme "rose-pine"
Set Padding 22
Set TypingSpeed 55ms
Set PlaybackSpeed 1
Set Framerate 24

Set Shell bash

# 준비 구간은 GIF에 담지 않는다.
Hide
Type "export PS1='$ ' && clear"  Enter
Type "cd /tmp/kigtit-demo/cafe"  Enter
Type "clear"  Enter
Show

Type "kigtit"  Sleep 500ms  Enter
Sleep 6s
