{
  "$schema": "https://unpkg.com/release-it/schema/release-it.json",
  "git": {
    "requireBranch": "main",
    "requireCleanWorkingDir": true,
    "commitMessage": "chore: release v${version}",
    "tagName": "v${version}",
    "tagAnnotation": "Kigtit v${version}",
    "push": true
  },
  "github": {
    "release": true,
    "releaseName": "v${version}",
    "releaseNotes": "node scripts/release-notes.mjs ${version}",
    "draft": true
  },
  "npm": {
    "publish": false
  },
  "hooks": {
    "before:init": [
      "cargo test -p kigtit-core",
      "cargo clippy -- -D warnings",
      "pnpm build"
    ],
    "after:bump": [
      "node scripts/sync-version.mjs ${version}",
      "git add Cargo.toml src-tauri/tauri.conf.json CHANGELOG.md"
    ],
    "after:release": "echo '\\n  Draft release created. Attach Kigtit.app after: cargo tauri build\\n'"
  }
}
